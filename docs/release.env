# Source it from the directory that contains the checkout: . EAGLE-4/docs/release.env
# Distribution locations for eagle-harness 0.1.1. Publication is a separate release gate.
# The engines did not change in 0.1.1: their wheels stay on the v0.1.0 GitHub release (EAGLE_RELEASE_ASSETS), which
# the wheel indexes serve, and the published images are the 0.1.0 images, which carry eagle-harness 0.1.0.
export EAGLE_HARNESS_VERSION='0.1.1'
export EAGLE_IMAGE_VERSION='0.1.0'
export EAGLE_WHEEL_ROOT='https://eagle-hq.github.io/EAGLE-4/whl'
export EAGLE_CUDA_INDEX="$EAGLE_WHEEL_ROOT/cu130/"
export EAGLE_ROCM_INDEX="$EAGLE_WHEEL_ROOT/rocm/"
# AMD's indexes for the ROCm Triton and Torchvision builds in docker/rocm/requirements.lock.
export EAGLE_AMD_TRITON_INDEX='https://pypi.amd.com/triton/release/rocm-7.2.0/simple/'
export EAGLE_AMD_ROCM_WHEELS='https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2/'
export EAGLE_RELEASE_ASSETS='https://github.com/eagle-hq/EAGLE-4/releases/tag/v0.1.0'
export EAGLE_IMAGE_ROOT='ghcr.io/eagle-hq/eagle-4'
export EAGLE_SGLANG_IMAGE="$EAGLE_IMAGE_ROOT-sglang:$EAGLE_IMAGE_VERSION"
# Not published yet: build it locally (docs/install.md, "Build the ROCm image").
export EAGLE_ROCM_IMAGE="$EAGLE_IMAGE_ROOT-sglang-rocm:$EAGLE_IMAGE_VERSION"
export EAGLE_VLLM_IMAGE="$EAGLE_IMAGE_ROOT-vllm:$EAGLE_IMAGE_VERSION"
export EAGLE_TOKENSPEED_IMAGE="$EAGLE_IMAGE_ROOT-tokenspeed:$EAGLE_IMAGE_VERSION"
export EAGLE_SGLANG_VERSION='0.5.23.dev252+eagle.4'
export EAGLE_ROCM_VERSION='0.5.23.dev252+eagle.4.rocm'
export EAGLE_VLLM_VERSION='0.32.0rc1.dev283+eagle.4'
export EAGLE_TOKENSPEED_VERSION='0.1.1+eagle.4'
export EAGLE_TORCH_CUDA_INDEX='https://download.pytorch.org/whl/cu130'
# The pinned SGLang dependency cuda-tile==1.6.0rc5 has vendor wheels here.
export EAGLE_NVIDIA_INDEX='https://pypi.nvidia.com'
# These are coupled native packages from the same TokenSpeed release source.
export EAGLE_TOKENSPEED_AUX_REQUIREMENTS='tokenspeed-scheduler==0.1.40+eagle.4 tokenspeed-kernel==0.1.4+eagle.4'
