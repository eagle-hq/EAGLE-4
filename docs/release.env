export EAGLE_ROCM_IMAGE="$EAGLE_IMAGE_ROOT-sglang-rocm:$EAGLE_VERSION"
export EAGLE_VLLM_IMAGE="$EAGLE_IMAGE_ROOT-vllm:$EAGLE_VERSION"
export EAGLE_TOKENSPEED_IMAGE="$EAGLE_IMAGE_ROOT-tokenspeed:$EAGLE_VERSION"
export EAGLE_SGLANG_VERSION='0.5.23.dev252+eagle.4'
export EAGLE_ROCM_VERSION='0.5.23.dev252+eagle.4.rocm'
